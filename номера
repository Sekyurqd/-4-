Задание №1
#include <iostream>
using namespace std;
int main(){
    long long a,b; char o;
    cin>>a>>o>>b;
    if(o=='+') cout<<a+b;
    else if(o=='-') cout<<a-b;
    else if(o=='*') cout<<a*b;
    else cout<<a/b;
}
