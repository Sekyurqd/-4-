Задание №3
#include <iostream>
#include <string>
using namespace std;
int main(){
    int x;
    cin>>x;
    int v[]={1000,900,500,400,100,90,50,40,10,9,5,4,1};
    string s[]={"M","CM","D","CD","C","XC","L","XL","X","IX","V","IV","I"};
    string r="";
    for(int i=0;i<13;i++)
        while(x>=v[i]){r+=s[i];x-=v[i];}
    cout<<r;
}
